# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Used only by the optional proxy server (`npm run server`).

# Port/host for the proxy (the Vite dev server forwards /api/* here).
PORT=8787
HOST=127.0.0.1

# Server-side API keys. When set, the browser does not need to know them:
# enable "Route through local proxy" for the provider in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional upstream overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI-compatible local LLM (Ollama default shown; LM Studio: http://localhost:1234/v1)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=
